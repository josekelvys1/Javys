# Chave da API da Anthropic. Se você já autenticou com `ant auth login`,
# pode deixar em branco.
ANTHROPIC_API_KEY=

# Número de WhatsApp do Dono (quem pode comandar o Jarvis), com DDI e DDD,
# somente dígitos. Ex: 5511999999999
OWNER_WHATSAPP_NUMBER=

# Fuso horário do Dono
TIMEZONE=America/Sao_Paulo

# Horário do briefing matinal (HH:mm, no fuso acima)
MORNING_BRIEFING_TIME=07:00

# Intervalo (ms) em que o Jarvis confere lembretes vencidos
REMINDER_CHECK_INTERVAL_MS=30000

# Intervalo (ms) em que o Jarvis confere hábitos vencidos (academia, água etc.)
HABIT_CHECK_INTERVAL_MS=60000

# Modelo Claude usado pelo Jarvis e nível de esforço de raciocínio
JARVIS_MODEL=claude-opus-5
JARVIS_EFFORT=medium

# Diretório onde ficam os dados locais (lembretes, sessão do WhatsApp etc.)
DATA_DIR=./data

LOG_LEVEL=info
